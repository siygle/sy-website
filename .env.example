# Giscus (GitHub Discussions) - get values from https://giscus.app
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=

# Bluesky handle for constructing post URLs
PUBLIC_BLUESKY_HANDLE=sylee.dev

# ── Newsletter ──────────────────────────────────────────────────────────────
# 'files' (default) reads src/content/newsletter/*.md. 'cms' reads Cloudflare D1.
NEWSLETTER_SOURCE=files

# Build-time D1 access (cms mode). A Worker binding is not reachable from the
# Node build process, so build/import/export use the D1 REST API.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Public base URL for R2-hosted newsletter images (e.g. https://media.sylee.dev)
NEWSLETTER_MEDIA_BASE=

# Runtime admin secrets — set with `wrangler secret put` in production,
# and in .dev.vars for local `wrangler dev`. Do NOT commit real values.
NEWSLETTER_ADMIN_PASSWORD=
NEWSLETTER_SESSION_SECRET=
NEWSLETTER_DEPLOY_HOOK_URL=
