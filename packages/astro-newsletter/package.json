{
  "name": "@sylee/astro-newsletter",
  "version": "0.1.0",
  "type": "module",
  "description": "Astro integration for the 網路黑手的呢喃 newsletter — switchable between local markdown files and a Cloudflare (D1 + R2) CMS.",
  "exports": {
    ".": "./src/index.ts",
    "./content": "./src/content.ts",
    "./styles": "./src/styles/newsletter.css"
  },
  "files": [
    "src",
    "bin"
  ],
  "bin": {
    "newsletter": "./bin/newsletter.mjs"
  },
  "peerDependencies": {
    "@astrojs/react": "^5",
    "astro": "^6",
    "react": "^19"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.17",
    "@uiw/react-md-editor": "^4.1.1",
    "rehype-highlight": "~7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "~4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "~5.0.0"
  }
}
