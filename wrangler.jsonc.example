{
  // ⚠️ TEMPLATE — kept as `.example` on purpose.
  //
  // @astrojs/cloudflare AUTO-DETECTS a root `wrangler.jsonc` at build time, so
  // an active copy with placeholder values would break `pnpm build` (and could
  // poison the existing `deploy --config dist/server/wrangler.json` flow). This
  // stays as a template until real Cloudflare resources exist.
  //
  // When provisioning the CMS:
  //   1. Copy to `wrangler.jsonc` and fill every "<...>" placeholder (D1
  //      database_name/id, R2 bucket_name, the SESSION KV id).
  //   2. Re-check `main`, `no_bundle`, `rules`, `compatibility_date` still match
  //      a fresh `pnpm build`'s dist/server/wrangler.json (they can drift as the
  //      adapter updates). The values below were copied from it on 2026-08-14.
  //   3. Run `wrangler deploy --dry-run` and confirm bindings + entry resolve.
  //   4. Flip .github/workflows/deploy.yml to `deploy` (Phase 6).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sylee-dev",
  "main": "./dist/server/entry.mjs",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "binding": "ASSETS", "directory": "./dist/client" },
  "observability": { "enabled": true },

  // Auto-added by @astrojs/cloudflare for Astro sessions — must be preserved.
  "kv_namespaces": [{ "binding": "SESSION", "id": "<SESSION_KV_ID>" }],

  // Newsletter CMS bindings (Phase 3+).
  "d1_databases": [
    {
      "binding": "NEWSLETTER_DB",
      "database_name": "<NEWSLETTER_D1_NAME>",
      "database_id": "<NEWSLETTER_D1_ID>"
    }
  ],
  "r2_buckets": [{ "binding": "NEWSLETTER_MEDIA", "bucket_name": "<NEWSLETTER_R2_BUCKET>" }]
}
